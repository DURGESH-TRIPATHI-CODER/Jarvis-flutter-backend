# JARVIS backend environment variables (set these in Vercel → Project → Settings → Environment Variables)

# Shared secret the Android app sends as `Authorization: Bearer <key>`.
# Generate a long random string, e.g.: openssl rand -hex 32
JARVIS_API_KEY=replace-with-a-long-random-secret

# NVIDIA NIM API key (https://build.nvidia.com — never shipped in the APK).
NVIDIA_API_KEY=nvapi-replace-me

# Optional: comma-separated model allowlist. Defaults are built in.
# ALLOWED_MODELS=meta/llama-3.1-8b-instruct,meta/llama-3.1-70b-instruct

# Optional: default model when the client does not send one.
# DEFAULT_MODEL=meta/llama-3.1-8b-instruct

# Optional: requests per API key per minute.
# RATE_LIMIT_PER_MINUTE=30
